# Copie este arquivo para .env e preencha os valores reais.
# .env NÃO é versionado (está no .gitignore).
#
# Este .env é o caminho do PC PESSOAL (nomes canônicos). No ambiente do banco,
# os segredos vêm de variáveis de ambiente da conta (ex.: token_calc_B3,
# token_fianalytics, user_fianalytics, password_fianalytics, proxy_http,
# proxy_https) e este arquivo não é necessário. O mapeamento nome->variável
# está em [env] no config.toml (só nomes, nunca valores).
#
# Emails de destinatários NÃO ficam aqui: use code/destinatarios.py
# (copie de destinatarios.example.py).

# FI Analytics — login do site (planilha de ativos)
FIANALYTICS_USER=
FIANALYTICS_PASS=

# FI Analytics — API calculadora
FIANALYTICS_API_KEY=

# B3 Calculator API
B3_CALC_TOKEN=

# Proxy (opcional — necessário na rede corporativa)
HTTPS_PROXY=
HTTP_PROXY=

# Email — destino dos [OK]/[ERROR] (lista separada por ; ou vírgula).
# Alternativa: definir OUTLOOK_TO em code/destinatarios.py.
OUTLOOK_TO=antoniopx12@gmail.com
