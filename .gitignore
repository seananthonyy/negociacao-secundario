# .gitignore RAIZ do repositório. O code/.gitignore cobre a subpasta code/.
# Defesa em profundidade: repetimos aqui os segredos e binários grandes.

# --- Segredos / config local (NUNCA versionar) ---
.env
code/files/.env
code/Helpers/destinatarios.py

# --- Banco de dados e backups (grandes; regeneráveis) ---
*.db
*.db-journal
*.db-wal
code/files/Database/

# --- Saídas geradas / dados brutos (regeneráveis) ---
# O log de cada script cai na pasta do proprio script (ver Helpers/logger.py).
code/codigos/*/logs/
code/files/logs/
code/files/relatorios/
code/files/anbima_data_raw/
code/files/api_samples/
code/files/debug/
code/files/diagnosticos/
code/files/emails/

# --- Ferramentas / editores ---
.obsidian/
.vscode/
__pycache__/
*.pyc
.venv/
venv/
.playwright/
.ipynb_checkpoints/

# Config local do Claude Code (pessoal)
.claude/settings.local.json
pv.html

# Artefatos ad-hoc de depuracao (respostas de API, coberturas) — nao versionar
code/files/fianalytics_resposta.json
code/files/cobertura_fontes.csv
