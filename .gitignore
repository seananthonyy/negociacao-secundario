# .gitignore RAIZ do repositório. O code/.gitignore cobre a subpasta code/.
# Defesa em profundidade: repetimos aqui os segredos e binários grandes.

# --- Segredos / config local (NUNCA versionar) ---
code/.env
.env
code/destinatarios.py

# --- Banco de dados e backups (grandes; regeneráveis) ---
*.db
*.db-journal
*.db-wal
code/data/*.db

# --- Saídas geradas / dados brutos (regeneráveis) ---
code/data/logs/
code/data/relatorios/
code/data/anbima_data_raw/
code/data/api_samples/
code/data/debug/
code/data/backups/
code/data/diagnosticos/

# --- Ferramentas / editores ---
.obsidian/
.vscode/
__pycache__/
*.pyc
.venv/
venv/
.playwright/
.ipynb_checkpoints/

# Config local do Claude Code (pessoal)
.claude/settings.local.json
pv.html

# Artefatos ad-hoc de depuracao (respostas de API, coberturas) — nao versionar
code/data/fianalytics_resposta.json
code/data/cobertura_fontes.csv
